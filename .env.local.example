# =====================================================================
# Q Task — Environment Variables Template
# =====================================================================
# Copy to .env.local and fill in your Azure OpenAI credentials.

# ----------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development
NEXT_PUBLIC_DEV_MODE=1

# ----------------------------------------------------------------------
# Azure OpenAI (for OpenAI Agents SDK)
# ----------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_BASE_URL=https://<your-resource>.cognitiveservices.azure.com/openai/deployments/<deployment-name>
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
